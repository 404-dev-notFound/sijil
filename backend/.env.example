# Copy to backend/.env.local (gitignored) and fill in real values.
# Settings fail fast on startup if a required variable below is missing — see
# app/config/settings.py and architecture doc Section 22.

ENV=dev
DATABASE_URL=postgresql+asyncpg://sijil:sijil@localhost:5432/sijil
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-every-environment
OBJECT_STORAGE_BUCKET=sijil-documents-dev
# Points at the docker-compose MinIO service for local dev; unset (empty) targets real
# AWS S3 / a UAE-region equivalent in staging/production.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1

# Leave provider=mock for local dev — MockLLMClient/MockOCRClient are used instead of
# live APIs so development never burns real credits (architecture doc Section 13).
# Set LLM_PROVIDER=claude + a real LLM_API_KEY to use real document extraction and HS
# classification reasoning (app/integrations/llm_client.py's ClaudeLLMClient).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-opus-5
OCR_PROVIDER=mock
OCR_API_KEY=

# Below these, a result is flagged needs_manual_review rather than silently accepted
# as certain (architecture doc "Do Not Do This" rules).
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# Local embedding model for HS classification vector search — no API key needed
# (app/integrations/embedding_client.py). Changing this requires re-embedding the
# whole tariff_headings table (its dimension is fixed at ingest time).
EMBEDDING_MODEL=all-MiniLM-L6-v2
TARIFF_KB_SEARCH_LIMIT=10

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
