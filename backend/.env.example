# Copy to backend/.env.local (gitignored) and fill in real values.
# Settings fail fast on startup if a required variable below is missing — see
# app/config/settings.py and architecture doc Section 22.

ENV=dev
DATABASE_URL=postgresql+asyncpg://sijil:sijil@localhost:5432/sijil
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-every-environment
OBJECT_STORAGE_BUCKET=sijil-documents-dev
OBJECT_STORAGE_ENDPOINT=

# Leave provider=mock for local dev — MockLLMClient/MockOCRClient are used instead of
# live APIs so development never burns real credits (architecture doc Section 13).
LLM_PROVIDER=mock
LLM_API_KEY=
OCR_PROVIDER=mock
OCR_API_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
